<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<meta name="theme-color" content="#4f46e5" />
<title>Rohee — Shop Beautifully</title>
<style>
  /* ============================================================
     RESET & TOKENS
     ============================================================ */
  *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }

  :root {
    --bg: #f6f7fb;
    --surface: #ffffff;
    --surface-2: #f2f4fa;
    --text: #0f172a;
    --text-muted: #6b7280;
    --border: #e8ebf3;
    --primary: #6d5efc;
    --primary-dark: #5244d6;
    --primary-light: #efedff;
    --accent: #ff6ba8;
    --success: #10b981;
    --danger: #ef4444;
    --warning: #f59e0b;
    --star: #fbbf24;
    --r-sm: 10px;
    --r-md: 16px;
    --r-lg: 22px;
    --r-xl: 30px;
    --r-full: 999px;
    --shadow-sm: 0 1px 2px rgba(15, 23, 42, 0.05);
    --shadow-md: 0 4px 14px rgba(15, 23, 42, 0.07);
    --shadow-lg: 0 14px 34px rgba(15, 23, 42, 0.10);
    --shadow-xl: 0 24px 60px rgba(15, 23, 42, 0.16);
    --ease: cubic-bezier(0.4, 0, 0.2, 1);
    --t-fast: 0.15s var(--ease);
    --t-base: 0.25s var(--ease);
    --t-slow: 0.4s var(--ease);
    --header-h: 74px;
    --max-w: 1300px;
  }

  html { scroll-behavior: smooth; }

  body {
    font-family: 'Inter', system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
    background: var(--bg);
    color: var(--text);
    line-height: 1.5;
    -webkit-font-smoothing: antialiased;
    min-height: 100vh;
  }

  img { display: block; max-width: 100%; }
  button { font-family: inherit; cursor: pointer; border: none; background: none; color: inherit; }
  input, select, textarea { font-family: inherit; }
  a { color: inherit; text-decoration: none; }
  ul { list-style: none; }
  ::selection { background: var(--primary-light); color: var(--primary-dark); }

  /* Custom scrollbar */
  ::-webkit-scrollbar { width: 10px; height: 10px; }
  ::-webkit-scrollbar-track { background: var(--surface-2); }
  ::-webkit-scrollbar-thumb { background: #c8cce0; border-radius: var(--r-full); border: 2px solid var(--surface-2); }
  ::-webkit-scrollbar-thumb:hover { background: #a8adca; }

  /* ============================================================
     UTILITY
     ============================================================ */
  .container {
    width: 100%; max-width: var(--max-w);
    margin: 0 auto; padding: 0 22px;
  }

  .sr-only {
    position: absolute; width: 1px; height: 1px;
    padding: 0; margin: -1px; overflow: hidden;
    clip: rect(0 0 0 0); white-space: nowrap; border: 0;
  }

  /* ============================================================
     HEADER
     ============================================================ */
  .header {
    position: sticky; top: 0; z-index: 100;
    height: var(--header-h);
    background: rgba(255, 255, 255, 0.88);
    backdrop-filter: saturate(180%) blur(18px);
    -webkit-backdrop-filter: saturate(180%) blur(18px);
    border-bottom: 1px solid var(--border);
  }

  .header__inner {
    height: 100%; display: flex; align-items: center; gap: 20px;
  }

  .logo {
    display: flex; align-items: center; gap: 11px;
    font-weight: 800; font-size: 1.35rem; letter-spacing: -0.03em;
    flex-shrink: 0; cursor: pointer;
  }

  .logo__mark {
    width: 40px; height: 40px; border-radius: 13px;
    background: linear-gradient(135deg, var(--primary), var(--accent));
    display: grid; place-items: center;
    color: #fff; font-size: 1.3rem; font-weight: 800;
    box-shadow: 0 8px 20px rgba(109, 94, 252, 0.4);
    transition: transform var(--t-base);
  }

  .logo:hover .logo__mark { transform: rotate(-8deg) scale(1.05); }

  .logo__text {
    background: linear-gradient(135deg, var(--primary), var(--accent));
    -webkit-background-clip: text; background-clip: text;
    color: transparent;
  }

  .search {
    flex: 1; max-width: 560px;
    position: relative; display: flex; align-items: center;
  }

  .search__icon {
    position: absolute; left: 18px;
    color: var(--text-muted); pointer-events: none; display: flex;
  }

  .search__input {
    width: 100%; height: 48px;
    padding: 0 18px 0 50px;
    border-radius: var(--r-full);
    border: 1.5px solid transparent;
    background: var(--surface-2);
    font-size: 0.95rem; color: var(--text);
    outline: none; transition: all var(--t-fast);
  }

  .search__input::placeholder { color: var(--text-muted); }

  .search__input:focus {
    border-color: var(--primary);
    background: var(--surface);
    box-shadow: 0 0 0 4px var(--primary-light);
  }

  .header__actions {
    display: flex; align-items: center; gap: 6px;
    margin-left: auto; flex-shrink: 0;
  }

  .icon-btn {
    position: relative;
    width: 46px; height: 46px; border-radius: var(--r-full);
    display: grid; place-items: center;
    color: var(--text); transition: all var(--t-fast);
  }

  .icon-btn:hover { background: var(--primary-light); color: var(--primary); }
  .icon-btn:active { transform: scale(0.94); }

  .icon-btn__badge {
    position: absolute; top: 4px; right: 4px;
    min-width: 20px; height: 20px; padding: 0 5px;
    border-radius: var(--r-full);
    background: var(--accent); color: #fff;
    font-size: 0.68rem; font-weight: 700;
    display: grid; place-items: center;
    border: 2px solid var(--surface);
    transform: scale(0); transition: transform var(--t-base);
    box-shadow: 0 4px 10px rgba(255, 107, 168, 0.4);
  }

  .icon-btn__badge.is-visible { transform: scale(1); }

  /* ============================================================
     HERO
     ============================================================ */
  .hero {
    margin: 34px 0 48px;
    border-radius: var(--r-xl);
    overflow: hidden; position: relative;
    background: linear-gradient(125deg, #1a1440 0%, #6d5efc 55%, #ff6ba8 130%);
    color: #fff; padding: 60px 56px;
    isolation: isolate;
    box-shadow: 0 24px 60px -20px rgba(109, 94, 252, 0.5);
  }

  .hero::before {
    content: ''; position: absolute; inset: 0;
    background:
      radial-gradient(circle at 82% 18%, rgba(255,255,255,0.22), transparent 42%),
      radial-gradient(circle at 8% 88%, rgba(255,107,168,0.35), transparent 45%);
    z-index: -1;
  }

  .hero__deco {
    position: absolute; border-radius: 50%;
    pointer-events: none; z-index: -1;
  }

  .hero__deco.d1 {
    width: 300px; height: 300px;
    background: rgba(255,255,255,0.07);
    top: -100px; right: -60px;
    animation: floatSlow 12s ease-in-out infinite;
  }

  .hero__deco.d2 {
    width: 180px; height: 180px;
    background: rgba(255,107,168,0.2);
    bottom: -60px; right: 200px;
    animation: floatSlow 9s ease-in-out infinite reverse;
  }

  @keyframes floatSlow {
    0%, 100% { transform: translate(0, 0); }
    50% { transform: translate(20px, -20px); }
  }

  .hero__content { max-width: 580px; position: relative; z-index: 2; }

  .hero__badge {
    display: inline-flex; align-items: center; gap: 8px;
    padding: 7px 15px; border-radius: var(--r-full);
    background: rgba(255, 255, 255, 0.16);
    border: 1px solid rgba(255, 255, 255, 0.28);
    font-size: 0.8rem; font-weight: 700;
    letter-spacing: 0.02em; margin-bottom: 20px;
    backdrop-filter: blur(8px);
  }

  .hero__badge .dot {
    width: 7px; height: 7px; border-radius: 50%;
    background: #4ade80;
    box-shadow: 0 0 10px #4ade80;
    animation: pulseDot 1.8s ease-in-out infinite;
  }

  @keyframes pulseDot {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.4; }
  }

  .hero__title {
    font-size: clamp(2.1rem, 5vw, 3.4rem);
    font-weight: 800; line-height: 1.08;
    letter-spacing: -0.03em; margin-bottom: 18px;
  }

  .hero__title span {
    background: linear-gradient(90deg, #fbbf24, #ff6ba8);
    -webkit-background-clip: text; background-clip: text;
    color: transparent;
  }

  .hero__text {
    font-size: 1.08rem; color: rgba(255, 255, 255, 0.88);
    margin-bottom: 30px; max-width: 480px;
  }

  .hero__cta { display: flex; gap: 12px; flex-wrap: wrap; }

  .btn-primary {
    display: inline-flex; align-items: center; gap: 10px;
    padding: 15px 32px; border-radius: var(--r-full);
    background: #fff; color: var(--primary-dark);
    font-weight: 700; font-size: 1rem;
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.22);
    transition: all var(--t-base);
  }

  .btn-primary:hover {
    transform: translateY(-3px);
    box-shadow: 0 18px 40px rgba(0, 0, 0, 0.3);
  }

  .btn-primary:active { transform: translateY(0); }

  .btn-ghost {
    display: inline-flex; align-items: center; gap: 10px;
    padding: 15px 28px; border-radius: var(--r-full);
    background: rgba(255,255,255,0.12);
    border: 1.5px solid rgba(255,255,255,0.35);
    color: #fff; font-weight: 700; font-size: 1rem;
    backdrop-filter: blur(8px);
    transition: all var(--t-base);
  }

  .btn-ghost:hover { background: rgba(255,255,255,0.22); transform: translateY(-3px); }

  /* Trust strip */
  .trust {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
    margin-bottom: 48px;
  }

  .trust__item {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--r-lg);
    padding: 20px 18px;
    display: flex; align-items: center; gap: 14px;
    transition: all var(--t-base);
  }

  .trust__item:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-lg);
    border-color: #d9dcf0;
  }

  .trust__icon {
    width: 46px; height: 46px; border-radius: 14px;
    display: grid; place-items: center;
    background: var(--primary-light);
    color: var(--primary);
    flex-shrink: 0;
  }

  .trust__item:nth-child(2) .trust__icon { background: #fff0f7; color: var(--accent); }
  .trust__item:nth-child(3) .trust__icon { background: #ecfdf5; color: var(--success); }
  .trust__item:nth-child(4) .trust__icon { background: #fffbeb; color: var(--warning); }

  .trust__title { font-size: 0.92rem; font-weight: 700; }
  .trust__sub { font-size: 0.78rem; color: var(--text-muted); font-weight: 500; }

  /* ============================================================
     TOOLBAR
     ============================================================ */
  .toolbar {
    display: flex; align-items: center; justify-content: space-between;
    gap: 16px; margin-bottom: 28px; flex-wrap: wrap;
  }

  .section-head { display: flex; flex-direction: column; gap: 3px; }
  .section-head h2 {
    font-size: 1.7rem; font-weight: 800;
    letter-spacing: -0.02em;
    display: flex; align-items: center; gap: 10px;
  }

  .section-head h2::before {
    content: '';
    width: 6px; height: 26px; border-radius: var(--r-full);
    background: linear-gradient(180deg, var(--primary), var(--accent));
  }

  .section-head span { color: var(--text-muted); font-size: 0.9rem; font-weight: 500; padding-left: 16px; }

  .toolbar__controls { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }

  .chips {
    display: flex; gap: 8px; overflow-x: auto;
    padding-bottom: 4px; scrollbar-width: none;
  }

  .chips::-webkit-scrollbar { display: none; }

  .chip {
    padding: 10px 20px; border-radius: var(--r-full);
    background: var(--surface); border: 1.5px solid var(--border);
    font-size: 0.88rem; font-weight: 600; color: var(--text-muted);
    white-space: nowrap; transition: all var(--t-fast);
  }

  .chip:hover { border-color: var(--primary); color: var(--primary); transform: translateY(-1px); }

  .chip.is-active {
    background: linear-gradient(135deg, var(--primary), var(--primary-dark));
    border-color: transparent; color: #fff;
    box-shadow: 0 8px 18px rgba(109, 94, 252, 0.35);
  }

  .select {
    height: 46px; padding: 0 42px 0 18px;
    border-radius: var(--r-full);
    border: 1.5px solid var(--border);
    background: var(--surface) url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='14' height='14' viewBox='0 0 24 24' fill='none' stroke='%236b7280' stroke-width='2.5' stroke-linecap='round' stroke-linejoin='round'><polyline points='6 9 12 15 18 9'/></svg>") no-repeat right 18px center;
    font-size: 0.88rem; font-weight: 600; color: var(--text);
    appearance: none; cursor: pointer; outline: none;
    transition: all var(--t-fast);
  }

  .select:hover { border-color: #c8cce0; }
  .select:focus { border-color: var(--primary); box-shadow: 0 0 0 4px var(--primary-light); }

  /* ============================================================
     PRODUCT GRID
     ============================================================ */
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
    gap: 24px; padding-bottom: 80px;
  }

  .card {
    background: var(--surface);
    border-radius: var(--r-lg);
    border: 1px solid var(--border);
    overflow: hidden;
    display: flex; flex-direction: column;
    transition: all var(--t-base);
    position: relative;
    animation: cardIn 0.45s var(--ease) both;
  }

  @keyframes cardIn {
    from { opacity: 0; transform: translateY(18px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  .card:hover {
    transform: translateY(-8px);
    box-shadow: var(--shadow-lg);
    border-color: #d9dcf0;
  }

  .card__media {
    position: relative;
    aspect-ratio: 1 / 1;
    background: linear-gradient(145deg, #f9faff, #eef1fa);
    display: grid; place-items: center;
    overflow: hidden; cursor: pointer;
  }

  .card__media img {
    width: 76%; height: 76%; object-fit: contain;
    transition: transform var(--t-slow);
    filter: drop-shadow(0 12px 24px rgba(15, 23, 42, 0.13));
  }

  .card:hover .card__media img { transform: scale(1.1) rotate(-3deg); }

  .card__media::after {
    content: 'Quick View';
    position: absolute; bottom: 14px; left: 50%;
    transform: translate(-50%, 20px);
    padding: 9px 20px; border-radius: var(--r-full);
    background: rgba(15, 23, 42, 0.85);
    color: #fff; font-size: 0.78rem; font-weight: 700;
    letter-spacing: 0.02em;
    backdrop-filter: blur(8px);
    opacity: 0; transition: all var(--t-base);
    pointer-events: none;
    white-space: nowrap;
  }

  .card:hover .card__media::after { opacity: 1; transform: translate(-50%, 0); }

  .wish {
    position: absolute; top: 14px; right: 14px;
    width: 40px; height: 40px; border-radius: var(--r-full);
    background: rgba(255, 255, 255, 0.92);
    backdrop-filter: blur(8px);
    display: grid; place-items: center;
    color: var(--text-muted);
    box-shadow: var(--shadow-sm);
    transition: all var(--t-fast); z-index: 3;
  }

  .wish:hover { transform: scale(1.12); color: var(--accent); }
  .wish.is-active { color: var(--accent); }
  .wish.is-active svg { fill: currentColor; }

  .tag-sale {
    position: absolute; top: 14px; left: 14px;
    padding: 6px 13px; border-radius: var(--r-full);
    background: linear-gradient(135deg, #ef4444, #f97316);
    color: #fff; font-size: 0.72rem; font-weight: 800;
    letter-spacing: 0.04em;
    box-shadow: 0 8px 18px rgba(239, 68, 68, 0.4);
    z-index: 3;
  }

  .tag-new {
    position: absolute; top: 14px; left: 14px;
    padding: 6px 13px; border-radius: var(--r-full);
    background: linear-gradient(135deg, var(--success), #059669);
    color: #fff; font-size: 0.72rem; font-weight: 800;
    letter-spacing: 0.04em;
    box-shadow: 0 8px 18px rgba(16, 185, 129, 0.4);
    z-index: 3;
  }

  .card__body {
    padding: 18px 18px 20px;
    display: flex; flex-direction: column;
    flex: 1; gap: 9px;
  }

  .card__cat {
    font-size: 0.72rem; font-weight: 800;
    letter-spacing: 0.08em; text-transform: uppercase;
    color: var(--primary);
  }

  .card__title {
    font-size: 1.02rem; font-weight: 700;
    letter-spacing: -0.01em; line-height: 1.35;
    display: -webkit-box; -webkit-line-clamp: 2;
    -webkit-box-orient: vertical; overflow: hidden;
    min-height: 2.75em; cursor: pointer;
    transition: color var(--t-fast);
  }

  .card__title:hover { color: var(--primary); }

  .rating {
    display: flex; align-items: center; gap: 7px;
    font-size: 0.82rem; color: var(--text-muted); font-weight: 600;
  }

  .stars { display: flex; gap: 1.5px; color: var(--star); }

  .card__footer {
    margin-top: auto;
    display: flex; align-items: center; justify-content: space-between;
    gap: 10px; padding-top: 8px;
  }

  .price { display: flex; align-items: baseline; gap: 8px; flex-wrap: wrap; }
  .price__now { font-size: 1.28rem; font-weight: 800; letter-spacing: -0.02em; }
  .price__was { font-size: 0.82rem; color: var(--text-muted); text-decoration: line-through; font-weight: 500; }

  .btn-add {
    width: 46px; height: 46px; flex-shrink: 0;
    border-radius: 14px;
    background: linear-gradient(135deg, var(--primary), var(--primary-dark));
    color: #fff;
    display: grid; place-items: center;
    box-shadow: 0 8px 20px rgba(109, 94, 252, 0.35);
    transition: all var(--t-fast);
  }

  .btn-add:hover { transform: scale(1.08) rotate(-4deg); box-shadow: 0 12px 26px rgba(109, 94, 252, 0.5); }
  .btn-add:active { transform: scale(0.95); }
  .btn-add.is-added { background: linear-gradient(135deg, var(--success), #059669); box-shadow: 0 8px 20px rgba(16, 185, 129, 0.4); }

  .empty {
    grid-column: 1 / -1; text-align: center;
    padding: 90px 20px; color: var(--text-muted);
  }

  .empty svg { margin: 0 auto 18px; color: #cbd5e1; }
  .empty h3 { color: var(--text); font-size: 1.25rem; margin-bottom: 8px; font-weight: 800; }
  .empty p { font-size: 0.92rem; }

  /* ============================================================
     PRODUCT DETAIL MODAL
     ============================================================ */
  .modal-overlay {
    position: fixed; inset: 0;
    background: rgba(15, 23, 42, 0.62);
    backdrop-filter: blur(6px);
    z-index: 250;
    display: flex; align-items: center; justify-content: center;
    padding: 20px;
    opacity: 0; visibility: hidden;
    transition: opacity var(--t-base), visibility var(--t-base);
    overflow-y: auto;
  }

  .modal-overlay.is-open { opacity: 1; visibility: visible; }

  .modal {
    background: var(--surface);
    border-radius: var(--r-xl);
    max-width: 960px; width: 100%;
    max-height: 92vh; overflow-y: auto;
    box-shadow: var(--shadow-xl);
    transform: scale(0.92) translateY(20px);
    transition: transform var(--t-slow);
    position: relative;
  }

  .modal-overlay.is-open .modal { transform: scale(1) translateY(0); }

  .modal__close {
    position: absolute; top: 18px; right: 18px;
    width: 44px; height: 44px; border-radius: var(--r-full);
    background: rgba(255,255,255,0.95);
    display: grid; place-items: center;
    color: var(--text); z-index: 10;
    box-shadow: var(--shadow-md);
    transition: all var(--t-fast);
  }

  .modal__close:hover { background: var(--danger); color: #fff; transform: rotate(90deg); }

  .modal__grid {
    display: grid; grid-template-columns: 1fr 1fr; gap: 0;
  }

  .modal__media {
    background: linear-gradient(145deg, #f9faff, #eef1fa);
    display: grid; place-items: center;
    padding: 50px; position: relative;
    min-height: 420px;
    border-radius: var(--r-xl) 0 0 var(--r-xl);
  }

  .modal__media img {
    width: 100%; max-width: 360px;
    object-fit: contain;
    filter: drop-shadow(0 24px 48px rgba(15, 23, 42, 0.22));
    transition: transform var(--t-slow);
  }

  .modal__media:hover img { transform: scale(1.06) rotate(-4deg); }

  .modal__thumbnails {
    position: absolute; bottom: 24px; left: 50%;
    transform: translateX(-50%);
    display: flex; gap: 10px;
  }

  .thumb {
    width: 54px; height: 54px;
    border-radius: 12px;
    background: rgba(255,255,255,0.9);
    border: 2px solid var(--border);
    display: grid; place-items: center;
    cursor: pointer; padding: 6px;
    transition: all var(--t-fast);
    backdrop-filter: blur(6px);
  }

  .thumb img { width: 100%; height: 100%; object-fit: contain; }
  .thumb:hover { border-color: var(--primary); transform: translateY(-3px); }
  .thumb.is-active { border-color: var(--primary); box-shadow: 0 0 0 3px var(--primary-light); }

  .modal__info {
    padding: 44px 40px;
    display: flex; flex-direction: column; gap: 16px;
  }

  .modal__cat {
    font-size: 0.78rem; font-weight: 800;
    letter-spacing: 0.1em; text-transform: uppercase;
    color: var(--primary);
  }

  .modal__title {
    font-size: 1.9rem; font-weight: 800;
    letter-spacing: -0.02em; line-height: 1.2;
  }

  .modal__rating {
    display: flex; align-items: center; gap: 12px;
    font-size: 0.9rem; color: var(--text-muted); font-weight: 600;
  }

  .modal__rating .review-count { color: var(--primary); font-weight: 700; }

  .modal__price {
    display: flex; align-items: baseline; gap: 14px;
    flex-wrap: wrap; padding: 6px 0;
  }

  .modal__price .now {
    font-size: 2.1rem; font-weight: 800;
    letter-spacing: -0.02em; color: var(--primary);
  }

  .modal__price .was {
    font-size: 1.15rem; color: var(--text-muted);
    text-decoration: line-through;
  }

  .modal__price .discount {
    padding: 5px 13px; border-radius: var(--r-full);
    background: #fee2e2; color: var(--danger);
    font-size: 0.82rem; font-weight: 800;
  }

  .modal__desc {
